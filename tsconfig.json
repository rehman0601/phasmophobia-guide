{
  "compilerOptions": {
    "target": "ES2026",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2026", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "scripts", "tests"],
  "exclude": ["node_modules", "dist", ".astro"]
}